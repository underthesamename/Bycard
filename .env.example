# Valores exclusivamente locais. Troque todos os segredos em outros ambientes.
APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8080
WEB_ORIGIN=http://localhost:3000
SESSION_HMAC_KEY=local-only-change-this-key-before-any-deploy-32-bytes
SESSION_TTL_SECONDS=2592000
SESSION_IDLE_TTL_SECONDS=604800
SESSION_TOUCH_INTERVAL_SECONDS=300
CSRF_TTL_SECONDS=1800
RUST_LOG=bycard_api=debug,tower_http=info

POSTGRES_USER=bycard
POSTGRES_PASSWORD=bycard-local-only
POSTGRES_DB=bycard
POSTGRES_PORT=5432
DATABASE_URL=postgres://bycard:bycard-local-only@127.0.0.1:5432/bycard
TEST_DATABASE_URL=postgres://bycard:bycard-local-only@127.0.0.1:5432/bycard

# Consumida apenas pelo servidor Next.js para encaminhar /api/*.
API_UPSTREAM_URL=http://127.0.0.1:8080
