# Use somente no job de release do banco. Não injete DATABASE_MIGRATION_URL na API.
APP_ENV=production

# Papel restrito usado pela API e pela carga idempotente do catálogo.
DATABASE_URL=postgresql://bycard_app:__SET_IN_SECRET_MANAGER__@HOST:5432/bycard?sslmode=verify-full

# Papel proprietário do schema, usado exclusivamente para migrations.
DATABASE_MIGRATION_URL=postgresql://bycard_owner:__SET_IN_SECRET_MANAGER__@HOST:5432/bycard?sslmode=verify-full

# Nome do papel somente leitura usado por pg_dump. O papel deve existir antes da release.
DATABASE_BACKUP_ROLE=bycard_backup

# IDs públicos do catálogo inicial. Não há interpolação por shell no workflow.
TCGDEX_SET_IDS=me05 me01 sv09 sv08.5

# O job de backup usa variáveis libpq separadas para não expor senha em argumentos.
PGHOST=HOST
PGPORT=5432
PGDATABASE=bycard
PGUSER=bycard_backup
PGPASSWORD=__SET_IN_SECRET_MANAGER__
PGSSLMODE=verify-full
PGCHANNELBINDING=require

# Guarde também fora do GitHub. Sem esta chave, o dump cifrado é irrecuperável.
BACKUP_ENCRYPTION_KEY=__SET_IN_SECRET_MANAGER__
