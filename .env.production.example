# Contrato de produção. Armazene os valores reais no gestor de segredos da hospedagem.
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8080
WEB_ORIGIN=https://app.example.com
SESSION_HMAC_KEY=__SET_IN_SECRET_MANAGER__
SESSION_TTL_SECONDS=2592000
SESSION_IDLE_TTL_SECONDS=604800
SESSION_TOUCH_INTERVAL_SECONDS=300
CSRF_TTL_SECONDS=1800
RUST_LOG=bycard_api=info,tower_http=info

# Exige TLS com validação do certificado e do hostname do PostgreSQL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full

# Consumida apenas pelo servidor Next.js. Nunca use credenciais nesta URL.
API_UPSTREAM_URL=https://api.example.com
